{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QueryCastle",
  "version": "0.1.5",
  "identifier": "com.querycastle.app",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QueryCastle",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "decorations": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": [
          "sql"
        ],
        "name": "SQL File",
        "description": "SQL script file",
        "role": "Editor",
        "mimeType": "application/sql"
      },
      {
        "ext": [
          "db",
          "sqlite",
          "sqlite3"
        ],
        "name": "SQLite Database",
        "description": "SQLite database file",
        "role": "Editor",
        "mimeType": "application/x-sqlite3"
      }
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwOUZDM0JENEQ3Qjc4MDAKUldRQWVIdE52Y09mb0RHTTJqK3JteTltckxLTFdmMDhnOHd6amQwRGJDUHM0YjdGb2VxYkJXT3AK",
      "endpoints": [
        "https://github.com/liridonnikqi/querycastle/releases/latest/download/latest.json"
      ]
    }
  }
}


